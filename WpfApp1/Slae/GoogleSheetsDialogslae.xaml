<Window x:Class="WpfApp1.GoogleSheetsDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Загрузка из Google Sheets"
        Height="320"
        Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow">

	<Window.Resources>
		<Style x:Key="DialogButtonStyle" TargetType="Button">
			<Setter Property="Background" Value="#2C5F9E"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Height" Value="32"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Margin" Value="5,0,0,0"/>
			<Setter Property="FontFamily" Value="Segoe UI"/>
			<Setter Property="FontSize" Value="12"/>
		</Style>
	</Window.Resources>

	<Grid Margin="15">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- Заголовок -->
		<TextBlock Grid.Row="0"
                   Text="Введите ссылку на Google Sheets таблицу:"
                   FontWeight="SemiBold"
                   FontSize="13"
                   Margin="0,0,0,10"/>

		<!-- Поле для ввода ссылки -->
		<TextBox x:Name="UrlInputTextBox"
                 Grid.Row="1"
                 VerticalScrollBarVisibility="Auto"
                 AcceptsReturn="False"
                 FontFamily="Segoe UI"
                 FontSize="12"
                 Height="80"
                 TextWrapping="Wrap"
                 Padding="5"
                 BorderBrush="#CCCCCC"
                 BorderThickness="1"/>

		<!-- Инструкция -->
		<TextBlock Grid.Row="2"
                   Text="Примеры ссылок:"
                   FontWeight="SemiBold"
                   FontSize="12"
                   Margin="0,15,0,5"/>

		<!-- Примеры ссылок с переносами строк -->
		<Border Grid.Row="3"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                Background="#F9F9F9"
                Padding="10"
                Margin="0,0,0,15">
			<StackPanel>
				<TextBlock FontSize="11"
                           Foreground="#666"
                           TextWrapping="Wrap">
					• https://docs.google.com/spreadsheets/d/ABC123xyz/edit
				</TextBlock>
				<TextBlock FontSize="11"
                           Foreground="#666"
                           TextWrapping="Wrap"
                           Margin="0,2,0,0">
					• https://docs.google.com/spreadsheets/d/ABC123xyz
				</TextBlock>
				<TextBlock FontSize="11"
                           Foreground="#666"
                           TextWrapping="Wrap"
                           Margin="0,2,0,0">
					• https://docs.google.com/spreadsheets/d/ABC123xyz/edit?usp=sharing
				</TextBlock>
			</StackPanel>
		</Border>

		<!-- Кнопки -->
		<StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">
			<Button Content="Отмена"
                    Click="CancelButtonClickHandler"
                    Width="85"
                    Height="32"
                    Background="#777777"
                    Foreground="White"
                    BorderThickness="0"
                    FontFamily="Segoe UI"
                    FontSize="12"
                    Cursor="Hand"/>
			<Button Content="Загрузить"
                    Click="LoadButtonClickHandler"
                    Style="{StaticResource DialogButtonStyle}"
                    Width="85"/>
		</StackPanel>
	</Grid>
</Window>