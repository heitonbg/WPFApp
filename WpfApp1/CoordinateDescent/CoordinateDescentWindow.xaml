<Window x:Class="WpfApp1.CoordinateDescentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:h="http://helix-toolkit.org/wpf"
        mc:Ignorable="d"
        Title="Метод покоординатного спуска с 3D визуализацией"
        Height="850" Width="1600"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        SizeChanged="Window_SizeChanged"
        MinWidth="1200" MinHeight="700"
        WindowState="Normal"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <!-- Стили для Menu -->
        <Style x:Key="MainMenuStyle" TargetType="Menu">
            <Setter Property="Background" Value="#2C5F9E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="32"/>
        </Style>

        <Style x:Key="MenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <ContentPresenter x:Name="Header" ContentSource="Header" 
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  Margin="{TemplateBinding Padding}"/>
                                <Popup x:Name="PART_Popup" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" 
                                       Placement="Bottom" StaysOpen="False" 
                                       HorizontalOffset="0" VerticalOffset="-1">
                                    <Border x:Name="SubMenuBorder" Background="White" BorderBrush="#D1D1D1" 
                                            BorderThickness="1" CornerRadius="3">
                                        <ScrollViewer x:Name="SubMenuScrollViewer">
                                            <Grid RenderOptions.ClearTypeHint="Enabled">
                                                <ItemsPresenter x:Name="ItemsPresenter" 
                                                                KeyboardNavigation.DirectionalNavigation="Cycle" 
                                                                Grid.IsSharedSizeScope="true" 
                                                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" 
                                                                KeyboardNavigation.TabNavigation="Cycle"/>
                                            </Grid>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Role" Value="TopLevelHeader">
                                <Setter Property="Padding" Value="15,5"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#3A6DB0"/>
                            </Trigger>
                            <Trigger Property="IsSubmenuOpen" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#1E4A7A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SubMenuItemStyle" TargetType="MenuItem" BasedOn="{StaticResource MenuItemStyle}">
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="15,8"/>
        </Style>

        <Style x:Key="MenuSeparatorStyle" TargetType="Separator">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Margin" Value="10,5"/>
            <Setter Property="Height" Value="1"/>
        </Style>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#2C5F9E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="6" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,8"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3A6DB0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E4A7A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>

        <Style x:Key="GroupBoxStyle" TargetType="GroupBox">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#2C5F9E"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#2C5F9E"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="5,5,5,8"/>
        </Style>

        <Style x:Key="TextBoxStyle" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#2C5F9E"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#2C5F9E"/>
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="32"/>
        </Style>

        <Style x:Key="LabelStyle" TargetType="Label">
            <Setter Property="Foreground" Value="#2C5F9E"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0,0,5,0"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <Style x:Key="ComboBoxStyle" TargetType="ComboBox">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#2C5F9E"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#2C5F9E"/>
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="32"/>
        </Style>

        <Style x:Key="DataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#2C5F9E"/>
            <Setter Property="BorderBrush" Value="#2C5F9E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E0E0E0"/>
            <Setter Property="AlternatingRowBackground" Value="#F5F9FF"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="RowHeight" Value="28"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>

        <Style x:Key="WarningTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Red"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>
    </Window.Resources>

    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#f0f5fc" Offset="0.0"/>
            <GradientStop Color="#e8eff8" Offset="0.4"/>
            <GradientStop Color="#dde6f2" Offset="1.0"/>
        </LinearGradientBrush>
    </Window.Background>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Menu -->
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="*"/>
            <!-- Main Content -->
        </Grid.RowDefinitions>

        <!-- MenuStrip -->
        <Menu Grid.Row="0" Style="{StaticResource MainMenuStyle}">
            <MenuItem Header="Файл" Style="{StaticResource MenuItemStyle}">
                <MenuItem Header="Найти экстремум" Click="Calculate_Click" 
                          InputGestureText="F5" Style="{StaticResource SubMenuItemStyle}"/>
                <MenuItem Header="Примеры" Click="btnExamples_Click" 
                          Style="{StaticResource SubMenuItemStyle}"/>
                <Separator Style="{StaticResource MenuSeparatorStyle}"/>
                <MenuItem Header="Очистить всё" Click="Clear_Click" 
                          Style="{StaticResource SubMenuItemStyle}"/>
                <Separator Style="{StaticResource MenuSeparatorStyle}"/>
                <MenuItem Header="Выход" Click="Exit_Click" 
                          Style="{StaticResource SubMenuItemStyle}"/>
            </MenuItem>
            <MenuItem Header="Вид" Style="{StaticResource MenuItemStyle}">
                <MenuItem Header="Сбросить вид 3D" Click="btnResetView_Click" 
                          Style="{StaticResource SubMenuItemStyle}"/>
                <MenuItem Header="Переключить камеру" Click="btnToggleCamera_Click" 
                          Style="{StaticResource SubMenuItemStyle}"/>

                <!-- Новый подпункт: Управление 3D графиком -->
                <MenuItem Header="Управление 3D графиком" 
                          Click="Show3DControlsHelp_Click"
                          Style="{StaticResource SubMenuItemStyle}"/>

                <Separator Style="{StaticResource MenuSeparatorStyle}"/>
                <MenuItem Header="Показать сетку" IsCheckable="True" 
                          Name="miShowGrid" IsChecked="True"
                          Click="btnToggleGrid_Click" 
                          Style="{StaticResource SubMenuItemStyle}"/>
                <MenuItem Header="Показать поверхность" IsCheckable="True" 
                          Name="miShowSurface" IsChecked="True"
                          Click="btnToggleSurface_Click" 
                          Style="{StaticResource SubMenuItemStyle}"/>
                <MenuItem Header="Показать траекторию" IsCheckable="True" 
                          Name="miShowTrajectory" IsChecked="True"
                          Click="btnToggleTrajectory_Click" 
                          Style="{StaticResource SubMenuItemStyle}"/>
                <MenuItem Header="Показать изолинии" IsCheckable="True" 
                          Name="miShowContours" IsChecked="True"
                          Click="btnToggleContours_Click" 
                          Style="{StaticResource SubMenuItemStyle}"/>
            </MenuItem>
            <MenuItem Header="Справка" Style="{StaticResource MenuItemStyle}">
                <MenuItem Header="О методе покоординатного спуска" 
                          Click="AboutMethod_Click" 
                          Style="{StaticResource SubMenuItemStyle}"/>
                <MenuItem Header="Синтаксис функций" 
                          Click="HelpSyntax_Click" 
                          Style="{StaticResource SubMenuItemStyle}"/>
                <MenuItem Header="Управление 3D графиком" 
                          Click="Show3DControlsHelp_Click" 
                          Style="{StaticResource SubMenuItemStyle}"/>
            </MenuItem>
        </Menu>

        <!-- Header -->
        <Border Grid.Row="1" Background="#2C5F9E" Padding="20,15">
            <StackPanel>
                <TextBlock Text="Метод покоординатного спуска" 
                          FontSize="28"
                          FontWeight="Light"
                          Foreground="White"
                          HorizontalAlignment="Center"/>
                <TextBlock Text="Поиск экстремума функции двух переменных с 3D визуализацией"
                          FontSize="14"
                          Foreground="#CCFFFFFF"
                          HorizontalAlignment="Center"
                          Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="2" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Input and Results -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Function Input -->
                <GroupBox Grid.Row="0" Header="Функция и параметры" Style="{StaticResource GroupBoxStyle}">
                    <StackPanel>
                        <Label Content="Функция f(x,y):" Style="{StaticResource LabelStyle}"/>
                        <TextBox Name="txtFunction" Style="{StaticResource TextBoxStyle}" 
                                 Text="x^2 + y^2" Margin="0,0,0,8"/>
                        <TextBlock Text="Используйте: x^2, sin(x), exp(y), pow(x,2)" 
                                  Foreground="#666" FontSize="11" Margin="0,0,0,10"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Label Content="Тип:" Style="{StaticResource LabelStyle}"/>
                            <ComboBox Name="cmbExtremumType" Style="{StaticResource ComboBoxStyle}" Width="120">
                                <ComboBoxItem Content="Минимум" IsSelected="True"/>
                                <ComboBoxItem Content="Максимум"/>
                            </ComboBox>
                        </StackPanel>

                        <Label Content="Интервалы поиска:" Style="{StaticResource LabelStyle}"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="X:" Foreground="#2C5F9E" VerticalAlignment="Center"/>
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                <TextBox Name="txtXStart" Style="{StaticResource TextBoxStyle}" Text="-2" Width="70" Margin="0,0,5,0"/>
                                <TextBlock Text="до" Margin="5,0" VerticalAlignment="Center" Foreground="#2C5F9E"/>
                                <TextBox Name="txtXEnd" Style="{StaticResource TextBoxStyle}" Text="2" Width="70"/>
                            </StackPanel>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Y:" Foreground="#2C5F9E" VerticalAlignment="Center" Margin="0,5,0,0"/>
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,5,0,0">
                                <TextBox Name="txtYStart" Style="{StaticResource TextBoxStyle}" Text="-2" Width="70" Margin="0,0,5,0"/>
                                <TextBlock Text="до" Margin="5,0" VerticalAlignment="Center" Foreground="#2C5F9E"/>
                                <TextBox Name="txtYEnd" Style="{StaticResource TextBoxStyle}" Text="2" Width="70"/>
                            </StackPanel>
                        </Grid>

                        <Label Content="Начальная точка (опционально):" Style="{StaticResource LabelStyle}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="X₀:" Foreground="#2C5F9E" VerticalAlignment="Center" Width="30"/>
                            <TextBox Name="txtStartX" Style="{StaticResource TextBoxStyle}" Text="" Width="70" Margin="0,0,5,0"
                                     ToolTip="Начальная координата X (оставьте пустым для центра интервала)"/>
                            <TextBlock Text="Y₀:" Foreground="#2C5F9E" VerticalAlignment="Center" Width="30" Margin="10,0,0,0"/>
                            <TextBox Name="txtStartY" Style="{StaticResource TextBoxStyle}" Text="" Width="70"
                                     ToolTip="Начальная координата Y (оставьте пустым для центра интервала)"/>
                        </StackPanel>

                        <Label Content="Параметры алгоритма:" Style="{StaticResource LabelStyle}"/>
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,5">
                                <Label Content="Точность ε:" Style="{StaticResource LabelStyle}" Width="80"/>
                                <TextBox Name="txtEpsilon" Style="{StaticResource TextBoxStyle}" Text="0.001" Width="80"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="5,0,0,5">
                                <Label Content="Итераций:" Style="{StaticResource LabelStyle}" Width="70"/>
                                <TextBox Name="txtMaxIterations" Style="{StaticResource TextBoxStyle}" Text="100" Width="80"/>
                            </StackPanel>
                        </Grid>

                        <!-- Кнопки -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Name="btnExamples" Content="Примеры" 
                                    Style="{StaticResource ModernButton}" Width="90" 
                                    Margin="0,0,10,0" Click="btnExamples_Click"/>
                            <Button Name="btnClear" Content="Очистить" 
                                    Style="{StaticResource ModernButton}" Width="90" 
                                    Margin="0,0,10,0" Click="Clear_Click"/>
                            <Button Name="btnCalculate" Content="Найти экстремум" 
                                    Style="{StaticResource ModernButton}" Width="130" 
                                    Click="Calculate_Click"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- Results -->
                <GroupBox Grid.Row="1" Header="Результаты" Style="{StaticResource GroupBoxStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Экстремум:" 
                                      Foreground="#2C5F9E" Margin="0,2" Width="90"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Name="lblExtremumType" Text="-" 
                                      Foreground="#2C5F9E" FontWeight="Bold" Margin="0,2"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Точка:" 
                                      Foreground="#2C5F9E" Margin="0,2" Width="90"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Name="lblPoint" Text="(-, -)" 
                                      Foreground="#2C5F9E" FontWeight="Bold" Margin="0,2"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Значение:" 
                                      Foreground="#2C5F9E" Margin="0,2" Width="90"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Name="lblValue" Text="-" 
                                      Foreground="#2C5F9E" FontWeight="Bold" Margin="0,2"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Итераций:" 
                                      Foreground="#2C5F9E" Margin="0,2" Width="90"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Name="lblIterations" Text="-" 
                                      Foreground="#2C5F9E" FontWeight="Bold" Margin="0,2"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Статус:" 
                                      Foreground="#2C5F9E" Margin="0,2" Width="90"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Name="lblStatus" Text="-" 
                                      Foreground="#2C5F9E" FontWeight="Bold" Margin="0,2"/>

                            <TextBlock Grid.Row="5" Grid.Column="1" Name="lblWarning" 
                                      Style="{StaticResource WarningTextStyle}"
                                      Visibility="Collapsed"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- Iteration History -->
                <GroupBox Grid.Row="2" Header="История итераций" Style="{StaticResource GroupBoxStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="320">
                        <DataGrid Name="dgIterations" Style="{StaticResource DataGridStyle}" 
                                 Height="Auto" MinHeight="120">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Шаг" Binding="{Binding Iteration}" Width="40"/>
                                <DataGridTextColumn Header="X" Binding="{Binding X, StringFormat=F4}" Width="70"/>
                                <DataGridTextColumn Header="Y" Binding="{Binding Y, StringFormat=F4}" Width="70"/>
                                <DataGridTextColumn Header="f(x,y)" Binding="{Binding Value, StringFormat=F6}" Width="85"/>
                                <DataGridTextColumn Header="ΔX" Binding="{Binding DeltaX, StringFormat=E2}" Width="70"/>
                                <DataGridTextColumn Header="ΔY" Binding="{Binding DeltaY, StringFormat=E2}" Width="70"/>
                                <DataGridTextColumn Header="Направ." Binding="{Binding Direction}" Width="60"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </ScrollViewer>
                </GroupBox>
            </Grid>

            <!-- Right Panel: 3D Visualization and Convergence -->
            <Grid Grid.Column="1" Margin="15,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="220"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 3D Viewport -->
                <Border Grid.Row="0" BorderThickness="1" BorderBrush="#2C5F9E" CornerRadius="4" Padding="5">
                    <h:HelixViewport3D x:Name="viewport3D"
                                      ZoomExtentsWhenLoaded="True"
                                      ShowViewCube="True"
                                      ShowCoordinateSystem="True"
                                      CameraMode="Inspect"
                                      CameraRotationMode="Turntable"
                                      RotateGesture="LeftClick"
                                      PanGesture="MiddleClick"
                                      ZoomGesture="RightClick"
                                      ZoomAroundMouseDownPoint="True"
                                      RotateAroundMouseDownPoint="True"
                                      Background="White">
                        <h:SunLight/>
                        <h:DefaultLights/>
                    </h:HelixViewport3D>
                </Border>

                <!-- Convergence Graph -->
                <GroupBox Grid.Row="1" Header="График сходимости" Style="{StaticResource GroupBoxStyle}" Margin="0,10,0,0">
                    <Canvas Name="canvasConvergence" Background="White" Height="180">
                        <!-- График будет рисоваться программно -->
                    </Canvas>
                </GroupBox>

                <!-- Control Panel -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <Button Name="btnResetView" Content="Сбросить вид" 
                            Style="{StaticResource SmallButton}" Width="100"
                            Click="btnResetView_Click"/>
                    <Button Name="btnToggleCamera" Content="Режим: Inspect" 
                            Style="{StaticResource SmallButton}" Width="120"
                            Click="btnToggleCamera_Click" Margin="10,0,0,0"/>
                    <Button Name="btnToggleGrid" Content="Сетка" 
                            Style="{StaticResource SmallButton}" Width="80"
                            Click="btnToggleGrid_Click" Margin="10,0,0,0"/>
                    <Button Name="btnToggleSurface" Content="Поверхность" 
                            Style="{StaticResource SmallButton}" Width="100"
                            Click="btnToggleSurface_Click" Margin="10,0,0,0"/>
                    <Button Name="btnToggleTrajectory" Content="Траектория" 
                            Style="{StaticResource SmallButton}" Width="100"
                            Click="btnToggleTrajectory_Click" Margin="10,0,0,0"/>
                    <Button Name="btnToggleContours" Content="Изолинии" 
                            Style="{StaticResource SmallButton}" Width="100"
                            Click="btnToggleContours_Click" Margin="10,0,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>