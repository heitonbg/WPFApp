<Window x:Class="WpfApp1.IntegralMethodsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:oxy="http://oxyplot.org/wpf"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="Вычисление определенного интеграла" 
        Height="850" Width="1200"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Стиль для Menu -->
        <Style x:Key="MainMenuStyle" TargetType="Menu">
            <Setter Property="Background" Value="#2C5F9E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="30"/>
        </Style>

        <!-- Стиль для MenuItem -->
        <Style x:Key="MenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <ContentPresenter x:Name="Header" ContentSource="Header" 
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  Margin="{TemplateBinding Padding}"/>
                                <Popup x:Name="PART_Popup" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" 
                                       Placement="Bottom" StaysOpen="False" 
                                       HorizontalOffset="0" VerticalOffset="-1">
                                    <Border x:Name="SubMenuBorder" Background="White" BorderBrush="#D1D1D1" 
                                            BorderThickness="1" CornerRadius="3">
                                        <ScrollViewer x:Name="SubMenuScrollViewer" Style="{DynamicResource {ComponentResourceKey ResourceId=MenuScrollViewer, TypeInTargetAssembly={x:Type FrameworkElement}}}">
                                            <Grid RenderOptions.ClearTypeHint="Enabled">
                                                <ItemsPresenter x:Name="ItemsPresenter" 
                                                                KeyboardNavigation.DirectionalNavigation="Cycle" 
                                                                Grid.IsSharedSizeScope="true" 
                                                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" 
                                                                KeyboardNavigation.TabNavigation="Cycle"/>
                                            </Grid>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Role" Value="TopLevelHeader">
                                <Setter Property="Padding" Value="15,5"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#3A6DB0"/>
                            </Trigger>
                            <Trigger Property="IsSubmenuOpen" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#1E4A7A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для подменю MenuItem -->
        <Style x:Key="SubMenuItemStyle" TargetType="MenuItem" BasedOn="{StaticResource MenuItemStyle}">
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemIconColumnGroup"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter x:Name="Icon" ContentSource="Icon" Margin="0,0,10,0"/>
                                <ContentPresenter x:Name="Header" ContentSource="Header" 
                                                  Grid.Column="1"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  Margin="{TemplateBinding Padding}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#F0F5FC"/>
                                <Setter Property="Foreground" Value="#2C5F9E"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="#2C5F9E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для Separator в меню -->
        <Style x:Key="MenuSeparatorStyle" TargetType="Separator">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Margin" Value="10,5"/>
            <Setter Property="Height" Value="1"/>
        </Style>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#2C5F9E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter x:Name="contentPresenter" 
                                            ContentTemplate="{TemplateBinding ContentTemplate}"
                                            Content="{TemplateBinding Content}"
                                            ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Margin="10,5"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3A6DB0"/>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#30000000"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E4A7A"/>
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#B0B0B0"/>
                                <Setter TargetName="border" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#2C5F9E"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D1D1D1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#2C5F9E"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModernCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <Style x:Key="ResultLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#2C5F9E"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
        </Style>

        <Style x:Key="ResultValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
        </Style>

        <DropShadowEffect x:Key="DropShadowEffect" 
                          BlurRadius="8" 
                          ShadowDepth="0" 
                          Color="#30000000" 
                          Opacity="0.3"/>

        <!-- Converter для отображения числа с динамическим количеством знаков -->
        <local:PrecisionFormatConverter x:Key="PrecisionFormatConverter"/>
    </Window.Resources>

    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#f0f5fc" Offset="0.0" />
            <GradientStop Color="#e8eff8" Offset="0.4" />
            <GradientStop Color="#dde6f2" Offset="1.0" />
        </LinearGradientBrush>
    </Window.Background>

    <Grid>
        <!-- Главный контейнер с Menu наверху -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- MenuStrip с нормальными цветами -->
        <Menu Grid.Row="0" Style="{StaticResource MainMenuStyle}">
            <MenuItem Header="Файл" Style="{StaticResource MenuItemStyle}">
                <MenuItem Header="Рассчитать" Click="Calculate_Click" InputGestureText="F5" Style="{StaticResource SubMenuItemStyle}"/>
                <Separator Style="{StaticResource MenuSeparatorStyle}"/>
                <MenuItem Header="Очистить всё" Click="ClearAll_Click" Style="{StaticResource SubMenuItemStyle}"/>
                <Separator Style="{StaticResource MenuSeparatorStyle}"/>
                <MenuItem Header="Выход" Click="Exit_Click" Style="{StaticResource SubMenuItemStyle}"/>
            </MenuItem>
            <MenuItem Header="Режим" Style="{StaticResource MenuItemStyle}">
                <MenuItem Header="Пошаговый режим" Click="StartStepByStep_Click" Style="{StaticResource SubMenuItemStyle}"/>
                <MenuItem Header="Следующий шаг" Name="miNextStep" Click="NextStep_Click" IsEnabled="False" Style="{StaticResource SubMenuItemStyle}"/>
                <MenuItem Header="Сбросить шаги" Click="ResetSteps_Click" Style="{StaticResource SubMenuItemStyle}"/>
                <Separator Style="{StaticResource MenuSeparatorStyle}"/>
                <MenuItem Header="Случайные данные" Click="GenerateRandomData_Click" Style="{StaticResource SubMenuItemStyle}"/>
            </MenuItem>
            <MenuItem Header="Вид" Style="{StaticResource MenuItemStyle}">
                <MenuItem Header="Показать историю разбиений" IsCheckable="True" Name="miShowHistory" 
                          Checked="ShowHistory_Checked" Unchecked="ShowHistory_Unchecked" Style="{StaticResource SubMenuItemStyle}"/>
                <MenuItem Header="Показать сетку" IsCheckable="True" Name="miShowGrid" IsChecked="True" 
                          Click="ToggleGrid_Click" Style="{StaticResource SubMenuItemStyle}"/>
            </MenuItem>
            <MenuItem Header="Справка" Style="{StaticResource MenuItemStyle}">
                <MenuItem Header="Синтаксис функций" Click="Help_Click" Style="{StaticResource SubMenuItemStyle}"/>
                <MenuItem Header="О методах интегрирования" Click="AboutMethods_Click" Style="{StaticResource SubMenuItemStyle}"/>
            </MenuItem>
        </Menu>

        <!-- Основное содержимое -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,20">
                <TextBlock Text="Вычисление определенного интеграла" 
                          FontSize="28" 
                          FontWeight="Light" 
                          Foreground="#2C5F9E" 
                          HorizontalAlignment="Center"/>
                <TextBlock Text="∫[a,b] f(x)dx" 
                          FontSize="18" 
                          FontWeight="SemiBold" 
                          Foreground="#4A90E2" 
                          HorizontalAlignment="Center"
                          Margin="0,5,0,0"/>
            </StackPanel>

            <!-- Input Panel -->
            <Border Grid.Row="1" 
                    Background="White" 
                    CornerRadius="8" 
                    Padding="20"
                    Margin="0,0,0,20"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    Effect="{StaticResource DropShadowEffect}">
                <StackPanel>
                    <TextBlock Text="Параметры интеграла" Style="{StaticResource SectionTitle}"/>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Функция -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Функция f(x):" 
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="4" 
                                 Name="txtFunction" Style="{StaticResource ModernTextBox}"
                                 Text="sin(x)" 
                                 ToolTip="Введите математическое выражение функции (например: sin(x), x^2+1, exp(-x^2))"/>

                        <!-- Границы -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Интервал [a,b]:" 
                                   VerticalAlignment="Center" Margin="0,10,10,0"/>

                        <TextBox Grid.Row="1" Grid.Column="1" Name="txtA" 
                                 Style="{StaticResource ModernTextBox}" Text="0" 
                                 Width="120" Margin="0,10,5,0"/>

                        <TextBlock Grid.Row="1" Grid.Column="3" Text="до" 
                                   VerticalAlignment="Center" Margin="0,10,10,0"/>

                        <TextBox Grid.Row="1" Grid.Column="4" Name="txtB" 
                                 Style="{StaticResource ModernTextBox}" Text="3.14159" 
                                 Width="120" Margin="0,10,0,0"/>

                        <!-- Точность и N -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Точность ε:" 
                                   VerticalAlignment="Center" Margin="0,10,10,0"/>

                        <TextBox Grid.Row="2" Grid.Column="1" Name="txtEpsilon" 
                                 Style="{StaticResource ModernTextBox}" Text="0.0001" 
                                 Width="120" Margin="0,10,5,0"
                                 ToolTip="Требуемая точность вычисления (определяет количество знаков после запятой)"/>

                        <TextBlock Grid.Row="2" Grid.Column="3" Text="Разбиения N:" 
                                   VerticalAlignment="Center" Margin="0,10,10,0"/>

                        <Grid Grid.Row="2" Grid.Column="4" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Name="txtN" Style="{StaticResource ModernTextBox}" 
                                     Text="10" Width="100"
                                     ToolTip="Количество разбиений интервала"/>
                            <CheckBox Grid.Column="1" Name="cbAutoN" Content="Авто" 
                                      Style="{StaticResource ModernCheckBox}"
                                      VerticalAlignment="Center" Margin="10,0,0,0"
                                      Checked="AutoNCheckBox_Checked" 
                                      Unchecked="AutoNCheckBox_Unchecked"/>
                        </Grid>

                        <!-- Методы интегрирования -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Методы:" 
                                   VerticalAlignment="Top" Margin="0,20,10,0"/>

                        <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="4" 
                                    Orientation="Horizontal" Margin="0,20,0,0">
                            <CheckBox Name="cbRectLeft" Content="Прямоуг. (лев.)" 
                                      Style="{StaticResource ModernCheckBox}" IsChecked="True"/>
                            <CheckBox Name="cbRectRight" Content="Прямоуг. (прав.)" 
                                      Style="{StaticResource ModernCheckBox}"/>
                            <CheckBox Name="cbRectMid" Content="Прямоуг. (сред.)" 
                                      Style="{StaticResource ModernCheckBox}"/>
                            <CheckBox Name="cbTrapezoid" Content="Трапеций" 
                                      Style="{StaticResource ModernCheckBox}" IsChecked="True"/>
                            <CheckBox Name="cbSimpson" Content="Симпсона" 
                                      Style="{StaticResource ModernCheckBox}" IsChecked="True"/>
                        </StackPanel>
                    </Grid>

                    <!-- Кнопки управления (дублируют MenuStrip для удобства) -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                        <Button Name="btnCalculate" Content="Рассчитать (F5)" 
                                Style="{StaticResource ModernButton}" Width="160"
                                Click="Calculate_Click" 
                                Background="#2C5F9E"/>

                        <Button Name="btnStepByStep" Content="Пошаговый режим" 
                                Style="{StaticResource ModernButton}" Width="150" 
                                Click="StartStepByStep_Click" Margin="10,0,0,0"/>

                        <Button Name="btnNextStep" Content="Следующий шаг" 
                                Style="{StaticResource ModernButton}" Width="140" 
                                Click="NextStep_Click" IsEnabled="False" Margin="10,0,0,0"/>

                        <Button Name="btnClear" Content="Очистить всё" 
                                Style="{StaticResource ModernButton}" Width="120" 
                                Click="ClearAll_Click" Margin="10,0,0,0"
                                Background="#E74C3C"/>

                        <Button Name="btnRandom" Content="Случайные данные" 
                                Style="{StaticResource ModernButton}" Width="150" 
                                Click="GenerateRandomData_Click" Margin="10,0,0,0"
                                Background="#9B59B6"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Results and Chart -->
            <Grid Grid.Row="2" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="400"/>
                </Grid.ColumnDefinitions>

                <!-- Chart -->
                <Border Grid.Column="0" 
                        Background="White" 
                        CornerRadius="8" 
                        Margin="0,0,10,0"
                        BorderBrush="#E0E0E0"
                        BorderThickness="1"
                        Effect="{StaticResource DropShadowEffect}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="График функции и визуализация методов" 
                                   Style="{StaticResource SectionTitle}" Margin="20,15"/>
                        <oxy:PlotView Name="plotView" Grid.Row="1" Margin="10"/>

                        <!-- Панель управления историей разбиений -->
                        <Border Grid.Row="2" Background="#F5F9FF" BorderBrush="#E0E0E0" 
                                BorderThickness="0,1,0,0" Padding="10" Visibility="Collapsed" Name="historyPanel">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="История разбиений: " VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ComboBox Name="cmbHistoryN" Width="120" Margin="0,0,10,0" SelectionChanged="HistoryN_SelectionChanged">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Name="lblHistoryValue" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Results -->
                <Border Grid.Column="1" 
                        Background="White" 
                        CornerRadius="8" 
                        Padding="20"
                        BorderBrush="#E0E0E0"
                        BorderThickness="1"
                        Effect="{StaticResource DropShadowEffect}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Результаты вычислений" Style="{StaticResource SectionTitle}"/>

                            <!-- Информация о шагах -->
                            <Border BorderBrush="#FF9800" BorderThickness="1" Background="#FFF3E0" 
                                    CornerRadius="4" Padding="10" Margin="0,0,0,15">
                                <StackPanel>
                                    <TextBlock Text="Информация о вычислении:" FontWeight="Bold" Foreground="#F57C00"/>
                                    <TextBlock Name="lblStepInfo" Text="-" Margin="0,5,0,0"/>
                                    <TextBlock Name="tbModeInfo" Text="Режим: фиксированное N" Margin="0,5,0,0"/>
                                    <TextBlock Name="tbPrecisionInfo" Text="Точность: 0.0001" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Быстрые результаты -->
                            <TextBlock Text="Значения интеграла:" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <StackPanel Name="spResults" Margin="0,0,0,20"/>

                            <!-- Детальные результаты -->
                            <Border BorderBrush="#2C5F9E" BorderThickness="1" CornerRadius="4" 
                                    Padding="15" Background="#F8FAFF" Margin="0,0,0,20">
                                <StackPanel>
                                    <TextBlock Text="Сравнение методов" FontWeight="Bold" 
                                               Foreground="#2C5F9E" Margin="0,0,0,10"/>

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Метод" 
                                                   FontWeight="Bold" Foreground="#555"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Значение" 
                                                   FontWeight="Bold" Foreground="#555"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Прямоуг. (лев.):" 
                                                   Style="{StaticResource ResultLabel}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Name="tbRectLeft" 
                                                   Text="-" Style="{StaticResource ResultValue}"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Прямоуг. (прав.):" 
                                                   Style="{StaticResource ResultLabel}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Name="tbRectRight" 
                                                   Text="-" Style="{StaticResource ResultValue}"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Прямоуг. (сред.):" 
                                                   Style="{StaticResource ResultLabel}"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Name="tbRectMid" 
                                                   Text="-" Style="{StaticResource ResultValue}"/>

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Трапеций:" 
                                                   Style="{StaticResource ResultLabel}"/>
                                        <TextBlock Grid.Row="4" Grid.Column="1" Name="tbTrapezoid" 
                                                   Text="-" Style="{StaticResource ResultValue}"/>

                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Симпсона:" 
                                                   Style="{StaticResource ResultLabel}"/>
                                        <TextBlock Grid.Row="5" Grid.Column="1" Name="tbSimpson" 
                                                   Text="-" Style="{StaticResource ResultValue}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Оптимальный результат -->
                            <Border BorderBrush="#27AE60" BorderThickness="2" CornerRadius="6" 
                                    Padding="15" Background="#EDF7F0">
                                <StackPanel>
                                    <TextBlock Text="Наиболее точный результат" 
                                               FontWeight="Bold" Foreground="#27AE60" 
                                               Margin="0,0,0,10"/>

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Метод:" 
                                                   Style="{StaticResource ResultLabel}"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Name="tbOptimalMethod" 
                                                   Text="-" Style="{StaticResource ResultValue}"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Значение:" 
                                                   Style="{StaticResource ResultLabel}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Name="tbOptimalValue" 
                                                   Text="-" Style="{StaticResource ResultValue}"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Разбиений:" 
                                                   Style="{StaticResource ResultLabel}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Name="tbOptimalN" 
                                                   Text="-" Style="{StaticResource ResultValue}"/>

                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- Status Bar -->
            <Border Grid.Row="3" Background="#2C5F9E" CornerRadius="4" Padding="15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Name="lblStatus" Text="Готов к работе" 
                               Foreground="White" VerticalAlignment="Center"/>

